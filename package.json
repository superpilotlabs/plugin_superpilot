{
  "name": "plugin_superpilot",
  "version": "0.0.4",
  "description": "Salesforce B2C Commerce cartridge for Superpilot",
  "author": "Superpilot",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  },
  "scripts": {
    "check": "prettier --check . && eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "b2c code deploy ./cartridges",
    "deploy:ci": "b2c code deploy ./cartridges --delete --json",
    "deploy:meta": "b2c job import ./data"
  },
  "devDependencies": {
    "@salesforce/b2c-cli": "^2.12.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "vitest": "^3.2.7"
  }
}
